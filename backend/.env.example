DJANGO_SECRET_KEY=<generate-a-long-random-secret>
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://<your-vercel-domain>
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,https://<your-vercel-domain>
CORS_ALLOW_ALL_ORIGINS=false
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_SECURE_HSTS_SECONDS=0
API_STATE_PATH=.localdata/api_state.json

# Optional fixtures for local presentations only. Keep disabled in deployed environments.
SENTRIX_ENABLE_DEMO_DATA=false

# Map search geocoder. local = offline backend collections + coordinates only.
# nominatim = OpenStreetMap with built-in cache and 30 req/minute default limit.
# disabled = coordinate input only. Never use nominatim beyond its usage policy.
SENTRIX_GEOCODER_PROVIDER=local
SENTRIX_GEOCODER_CACHE_TTL_SECONDS=300
SENTRIX_GEOCODER_RATE_LIMIT=30

# PostGIS production path for proximity, zone intersection, and bbox queries.
# Local sqlite deployments leave these unset; spatial_store stays inert.
# DJANGO_DB_ENGINE=postgis
# DJANGO_DB_NAME=sentrix
# DJANGO_DB_USER=sentrix
# DJANGO_DB_PASSWORD=<backend-only-secret>
# DJANGO_DB_HOST=<postgres-host>
# DJANGO_DB_PORT=5432

# Authentication and passkey/Face ID configuration.
AUTH_REQUIRE_2FA=true
# Explicit local-only switches. Demo credentials/OTP are never enabled by
# default and demo OTP is accepted only from loopback clients.
AUTH_ALLOW_DEMO_USERS=false
AUTH_ALLOW_DEMO_OTP=false
AUTH_ADMIN_PHONE=
AUTH_COMMAND_PHONE=
AUTH_FIELD_PHONE=
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000

# Exotel live SMS. Never commit real values.
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_ACCOUNT_SID=
EXOTEL_SENDER_ID=
EXOTEL_REGION=mumbai
EXOTEL_TIMEOUT_SECONDS=15

# Guard dispatch verification OTP. Codes are hashed before storage.
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Firebase Admin configuration. Use either a service-account JSON file path
# or the inline values below; never expose these through NEXT_PUBLIC_* values.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_ID=
FIREBASE_ALERTS_COLLECTION=alerts
FCM_ENABLED=false
FCM_ALERT_TOPIC=sentrix-alerts

# Local browser preview / inference worker model. The default points to
# backend/.localdata/models/yolov8n.pt, which is intentionally ignored by Git.
PERSON_MODEL_PATH=
AI_FRAME_CONFIDENCE=0.50
AI_ENABLE_PERSON_TRACKING=true
AI_ENABLE_FACE_DETECTION=true
AI_ENABLE_ANPR=true
AI_FACE_CONFIDENCE=0.50
AI_ANPR_VEHICLE_CONFIDENCE=0.45
AI_ANPR_PLATE_CONFIDENCE=0.15
AI_ANPR_IMAGE_SIZE=736
AI_DEVICE=cuda
AI_FACE_FRAME_INTERVAL=3
AI_ANPR_FRAME_INTERVAL=5
AI_INFERENCE_MAX_DIM=960
FACE_MODEL_PATH=
ANPR_VEHICLE_MODEL_PATH=
ANPR_PLATE_MODEL_PATH=
WEAPON_MODEL_PATH=

# Optional local InsightFace detector/embedding provider. Disabled unless set.
# This requires separately approved model packages and their licenses.
FACE_PROVIDER=opencv_yolo
INSIGHTFACE_MODEL_NAME=buffalo_l
INSIGHTFACE_ROOT=

# Consent-gated face embedding comparison. Disabled by default.
FACE_MATCHING_ENABLED=false
FACE_MATCH_THRESHOLD=0.72
FACE_EMBEDDING_MODEL_PATH=

# Blockchain signer stays in the Django deployment secret manager.
BLOCKCHAIN_NETWORK=Sepolia testnet
BLOCKCHAIN_RPC_URL=<rpc-provider-url>
BLOCKCHAIN_CHAIN_ID=11155111
BLOCKCHAIN_CONTRACT_ADDRESS=<deployed-evidence-registry-address>
BLOCKCHAIN_SIGNER_PRIVATE_KEY=<backend-only-test-wallet-private-key>
BLOCKCHAIN_EXPLORER_BASE_URL=https://sepolia.etherscan.io
BLOCKCHAIN_CONFIRMATIONS=1
BLOCKCHAIN_TX_TIMEOUT_SECONDS=120
BLOCKCHAIN_DECISION_THRESHOLD=0.80

# Media relay configuration (MediaMTX / go2rtc)
MEDIA_RELAY_BASE_URL=http://127.0.0.1:8888
MEDIA_RELAY_WEBRTC_URL=http://127.0.0.1:8889
MEDIA_RELAY_API_URL=http://127.0.0.1:9997
MEDIA_RELAY_ENABLED=true
