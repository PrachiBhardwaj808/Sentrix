NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=sentrix-41ecc.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=sentrix-41ecc
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=sentrix-41ecc.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=<your-messaging-sender-id>
NEXT_PUBLIC_FIREBASE_APP_ID=<your-firebase-app-id>
